<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HpsWallet.Views.PendingPage"
             BackgroundColor="#0F0A1A"
             Title="Transferencias Pendentes">
    <Grid RowDefinitions="Auto,*" Padding="10">
        <Label x:Name="LoadingLabel" Grid.Row="0" Text="Carregando..." TextColor="#9CA3AF" FontSize="14" HorizontalOptions="Center" Margin="0,10" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ItemsContainer" Spacing="6" />
        </ScrollView>
    </Grid>
</ContentPage>
