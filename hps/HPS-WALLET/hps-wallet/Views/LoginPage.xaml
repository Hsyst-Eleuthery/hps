<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HpsWallet.Views.LoginPage"
             Title="HPS Wallet"
             BackgroundColor="#1A0A2E">

    <ScrollView>
        <StackLayout Padding="15" Spacing="15" VerticalOptions="Center">

            <Frame CornerRadius="20" BackgroundColor="#2D1B4E"
                   BorderColor="#7C3AED" Padding="20">
                <StackLayout Spacing="8">
                    <Label Text="HPS Wallet"
                           TextColor="White" FontSize="28" FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Carteira Peer-to-Peer Hsyst"
                           TextColor="#A78BFA" FontSize="14"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            <Frame CornerRadius="15" BackgroundColor="#2D1B4E"
                   BorderColor="#7C3AED" Padding="15">
                <StackLayout Spacing="12">
                    <Label Text="Conectar a Rede" TextColor="White" FontSize="18" FontAttributes="Bold" />

                    <Label Text="Servidor (host:porta)" TextColor="#C084FC" FontSize="12" />
                    <Entry x:Name="ServerEntry"
                           Placeholder="localhost:8080"
                           PlaceholderColor="#6B7280"
                           TextColor="White"
                           BackgroundColor="#1A0A2E" />

                    <Label Text="Usuario" TextColor="#C084FC" FontSize="12" />
                    <Entry x:Name="UsernameEntry"
                           Placeholder="Seu nome de usuario"
                           PlaceholderColor="#6B7280"
                           TextColor="White"
                           BackgroundColor="#1A0A2E" />

                    <Label Text="Senha (chave criptografica)" TextColor="#C084FC" FontSize="12" />
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Senha da chave"
                           PlaceholderColor="#6B7280"
                           TextColor="White"
                           BackgroundColor="#1A0A2E"
                           IsPassword="True" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Usar SSL/TLS"
                               TextColor="#C084FC" VerticalOptions="Center" FontSize="14" />
                        <Switch Grid.Column="1" x:Name="SslSwitch"
                                ThumbColor="#7C3AED" OnColor="#3D1A6E" />
                    </Grid>

                    <Button x:Name="ConnectButton"
                            Text="Entrar na Rede"
                            BackgroundColor="#7C3AED" TextColor="White"
                            FontAttributes="Bold" HeightRequest="50" CornerRadius="12"
                            Clicked="OnConnectClicked" />

                    <Label x:Name="StatusLabel" Text="" TextColor="#F87171" FontSize="13" HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            <Frame CornerRadius="15" BackgroundColor="#2D1B4E"
                   BorderColor="#7C3AED" Padding="15"
                   IsVisible="False" x:Name="ProgressFrame">
                <StackLayout Spacing="6">
                    <Label x:Name="ProgressTitle" Text="Conectando..." TextColor="White" FontSize="15" FontAttributes="Bold" />
                    <ProgressBar x:Name="ProgressBar" Progress="0" ProgressColor="#7C3AED" HeightRequest="6" />
                </StackLayout>
            </Frame>

            <Frame CornerRadius="15" BackgroundColor="#2D1B4E"
                   BorderColor="#3D1A6E" Padding="15">
                <StackLayout Spacing="6">
                    <Label Text="Servidores recentes"
                           TextColor="White" FontSize="14" FontAttributes="Bold" />
                    <Label Text="Toque para preencher o servidor"
                           TextColor="#6B7280" FontSize="10" />
                    <Label x:Name="RecentServersLabel"
                           Text="Nenhum"
                           TextColor="#9CA3AF" FontSize="13" />
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>

</ContentPage>
