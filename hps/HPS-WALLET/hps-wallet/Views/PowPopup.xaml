<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="HpsWallet.Views.PowPopup"
               CanBeDismissedByTappingOutsideOfPopup="False"
               Color="#CC1A0A2E">
    <Border BackgroundColor="#1A0A2E"
            StrokeShape="RoundRectangle 16"
            Stroke="#7C3AED"
            StrokeThickness="2"
            Padding="20"
            MaximumWidthRequest="360">
        <VerticalStackLayout Spacing="12">
            <Label Text="Prova de Trabalho (PoW)"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#7C3AED"
                   HorizontalOptions="Center" />

            <Label x:Name="StatusLabel"
                   Text="Aguardando..."
                   FontSize="14"
                   TextColor="#E2E8F0"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="#7C3AED" Margin="0,4" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <Label Text="Bits:" TextColor="#94A3B8" FontSize="12" />
                <Label x:Name="BitsLabel" Text="0" TextColor="#E2E8F0" FontSize="12" Grid.Column="1" />

                <Label Text="Tempo:" TextColor="#94A3B8" FontSize="12" Grid.Row="1" />
                <Label x:Name="ElapsedLabel" Text="0.0s" TextColor="#E2E8F0" FontSize="12" Grid.Row="1" Grid.Column="1" />

                <Label Text="Hashrate:" TextColor="#94A3B8" FontSize="12" Grid.Row="2" />
                <Label x:Name="HashrateLabel" Text="0 H/s" TextColor="#34D399" FontSize="12" Grid.Row="2" Grid.Column="1" />

                <Label Text="Tentativas:" TextColor="#94A3B8" FontSize="12" Grid.Row="3" />
                <Label x:Name="AttemptsLabel" Text="0" TextColor="#E2E8F0" FontSize="12" Grid.Row="3" Grid.Column="1" />
            </Grid>

            <ActivityIndicator IsRunning="True" Color="#7C3AED" HeightRequest="24" />

            <Border BackgroundColor="#0F0720"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#2D1B4E"
                    StrokeThickness="1"
                    Padding="8"
                    MaximumHeightRequest="120">
                <ScrollView>
                    <Label x:Name="LogLabel"
                           Text=""
                           TextColor="#94A3B8"
                           FontSize="11"
                           FontFamily="Consolas" />
                </ScrollView>
            </Border>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button x:Name="CancelButton"
                        Text="Cancelar"
                        BackgroundColor="#DC2626"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        WidthRequest="120"
                        Clicked="OnCancelClicked" />
                <Button x:Name="CloseButton"
                        Text="Fechar"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        WidthRequest="120"
                        IsVisible="False"
                        Clicked="OnCloseClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
