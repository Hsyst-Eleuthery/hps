<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HpsMobile.Views"
       x:Class="HpsMobile.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Navegar" Icon="globe.png" ContentTemplate="{DataTemplate views:BrowserPage}" Route="browser" />
        <ShellContent Title="Carteira" Icon="wallet.png" ContentTemplate="{DataTemplate views:WalletPage}" Route="wallet" />
        <ShellContent Title="Mineração" Icon="pick.png" ContentTemplate="{DataTemplate views:MiningPage}" Route="mining" />
        <ShellContent Title="Rede" Icon="network.png" ContentTemplate="{DataTemplate views:NetworkPage}" Route="network" />
        <ShellContent Title="Ajuda" Icon="help.png" ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings" />
    </TabBar>

</Shell>
