<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HpsMobile"
             x:Class="HpsMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBackground">#1A0A2E</Color>
            <Color x:Key="PrimaryAccent">#7C3AED</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#A78BFA</Color>
            <Color x:Key="SurfaceColor">#2D1B4E</Color>
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="{StaticResource PrimaryBackground}" />
                <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="Shell.TitleColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource PrimaryBackground}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaryAccent}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
