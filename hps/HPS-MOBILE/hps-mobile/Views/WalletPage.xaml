<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HpsMobile.Views.WalletPage"
             x:Name="ThisPage"
             Title="Carteira"
             BackgroundColor="#1A0A2E"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

        <!-- Balance Bar (always visible) -->
        <Border Grid.Row="0" BackgroundColor="#2D1B4E" Stroke="#7C3AED"
                StrokeShape="RoundRectangle 0" Padding="15,12" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="$HPS" TextColor="#C084FC"
                       FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                <StackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="BalanceLabel" Text="0 $HPS" TextColor="White"
                           FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="UserLabel" Text="" TextColor="#9CA3AF" FontSize="10" HorizontalOptions="Center" />
                </StackLayout>
                <Label Grid.Column="2" x:Name="MultiplierLabel" Text=""
                       TextColor="#6B7280" FontSize="10" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Tab Buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" BackgroundColor="#1A0A2E" Padding="0" ColumnSpacing="1">
            <Button x:Name="TabSendBtn" Text="Enviar"
                    BackgroundColor="#2D1B4E" TextColor="#C084FC" FontSize="11"
                    HeightRequest="40" CornerRadius="0" BorderWidth="0"
                    Clicked="OnTabClicked" />
            <Button x:Name="TabReceiveBtn" Grid.Column="1" Text="Receber"
                    BackgroundColor="#2D1B4E" TextColor="#C084FC" FontSize="11"
                    HeightRequest="40" CornerRadius="0" BorderWidth="0"
                    Clicked="OnTabClicked" />
            <Button x:Name="TabVoucherBtn" Grid.Column="2" Text="Voucher"
                    BackgroundColor="#2D1B4E" TextColor="#C084FC" FontSize="11"
                    HeightRequest="40" CornerRadius="0" BorderWidth="0"
                    Clicked="OnTabClicked" />
            <Button x:Name="TabExchangeBtn" Grid.Column="3" Text="Cambio"
                    BackgroundColor="#2D1B4E" TextColor="#C084FC" FontSize="11"
                    HeightRequest="40" CornerRadius="0" BorderWidth="0"
                    Clicked="OnTabClicked" />
            <Button x:Name="TabHistoryBtn" Grid.Column="4" Text="Historico"
                    BackgroundColor="#2D1B4E" TextColor="#C084FC" FontSize="11"
                    HeightRequest="40" CornerRadius="0" BorderWidth="0"
                    Clicked="OnTabClicked" />
        </Grid>

        <!-- Content Panels -->
        <Grid Grid.Row="2">

            <!-- SEND Panel -->
            <ScrollView x:Name="SendPanel" IsVisible="True">
                <StackLayout Padding="12" Spacing="12">
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#2D1B4E"
                            Stroke="#7C3AED" Padding="15">
                        <StackLayout Spacing="10">
                            <Label Text="Enviar $HPS" TextColor="White" FontSize="20" FontAttributes="Bold" />
                            <Label Text="Modelo burn-on-spend: o valor sera queimado ao ser enviado."
                                   TextColor="#F59E0B" FontSize="11" />
                            <Entry x:Name="RecipientEntry"
                                   Placeholder="Destinatario (usuario)"
                                   PlaceholderColor="#9CA3AF" TextColor="White"
                                   BackgroundColor="#1A0A2E" />
                            <Entry x:Name="AmountEntry"
                                   Placeholder="Valor ($HPS)"
                                   PlaceholderColor="#9CA3AF" TextColor="White"
                                   BackgroundColor="#1A0A2E" Keyboard="Numeric" />
                            <Button Text="Confirmar Transferencia"
                                    BackgroundColor="#7C3AED" TextColor="White"
                                    FontAttributes="Bold" HeightRequest="50" CornerRadius="12"
                                    Clicked="OnTransferConfirmed" />
                        </StackLayout>
                    </Border>
                </StackLayout>
            </ScrollView>

            <!-- RECEIVE Panel -->
            <ScrollView x:Name="ReceivePanel" IsVisible="False">
                <StackLayout Padding="12" Spacing="12">
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#2D1B4E"
                            Stroke="#7C3AED" Padding="15">
                        <StackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="Receber $HPS" TextColor="White" FontSize="20"
                                   FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Compartilhe seu usuario para receber pagamentos."
                                   TextColor="#9CA3AF" FontSize="12" HorizontalOptions="Center" />
                            <Border BackgroundColor="#1A0A2E" Stroke="#7C3AED"
                                    StrokeShape="RoundRectangle 8" Padding="15" Margin="0,5">
                                <StackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="Seu usuario" TextColor="#C084FC" FontSize="10" HorizontalOptions="Center" />
                                    <Label x:Name="MyUsernameDisplay" Text="" TextColor="White"
                                           FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                                </StackLayout>
                            </Border>
                            <Label Text="O remetente deve usar o mesmo servidor para enviar."
                                   TextColor="#A78BFA" FontSize="10" HorizontalOptions="Center" />
                        </StackLayout>
                    </Border>
                </StackLayout>
            </ScrollView>

            <!-- VOUCHER Panel -->
            <ScrollView x:Name="VoucherPanel" IsVisible="False">
                <StackLayout Padding="12" Spacing="12">
                    <!-- Check Voucher -->
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#2D1B4E"
                            Stroke="#7C3AED" Padding="15">
                        <StackLayout Spacing="10">
                            <Label Text="Verificar Voucher" TextColor="White" FontSize="18" FontAttributes="Bold" />
                            <Label Text="Digite o ID do voucher" TextColor="#9CA3AF" FontSize="12" />
                            <Entry x:Name="VoucherEntry"
                                   Placeholder="ID do voucher"
                                   PlaceholderColor="#6B7280" TextColor="White"
                                   BackgroundColor="#1A0A2E" />
                            <Button Text="Verificar" BackgroundColor="#7C3AED" TextColor="White"
                                    HeightRequest="45" CornerRadius="10" Clicked="OnCheckVoucher" />
                            <Border x:Name="VoucherInfoFrame" IsVisible="False"
                                    BackgroundColor="#1A0A2E" Stroke="#7C3AED"
                                    StrokeShape="RoundRectangle 8" Padding="10">
                                <StackLayout Spacing="4">
                                    <Label x:Name="VoucherIdLabel" TextColor="#C084FC" FontSize="11" />
                                    <Label Text="Valor:" TextColor="#9CA3AF" FontSize="11" />
                                    <Label x:Name="VoucherValueLabel" TextColor="White" FontSize="22" FontAttributes="Bold" />
                                    <Label x:Name="VoucherOwnerLabel" TextColor="#9CA3AF" FontSize="11" />
                                    <Label x:Name="VoucherStatusLabel" TextColor="#10B981" FontSize="11" />
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </Border>

                    <!-- Ghost Voucher -->
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#2D1B4E"
                            Stroke="#DC2626" Padding="15">
                        <StackLayout Spacing="10">
                            <Label Text="Destruir Voucher (Ghost)" TextColor="#FCA5A5" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Invalide permanentemente um voucher emitido."
                                   TextColor="#9CA3AF" FontSize="12" />
                            <Entry x:Name="GhostVoucherEntry"
                                   Placeholder="ID do voucher para ghost"
                                   PlaceholderColor="#6B7280" TextColor="White"
                                   BackgroundColor="#1A0A2E" />
                            <Button Text="Ghost Voucher" BackgroundColor="#DC2626" TextColor="White"
                                    FontAttributes="Bold" HeightRequest="40" CornerRadius="10"
                                    Clicked="OnGhostVoucher" />
                            <Label x:Name="GhostStatusLabel" Text="" TextColor="#FBBF24" FontSize="12" />
                        </StackLayout>
                    </Border>
                </StackLayout>
            </ScrollView>

            <!-- EXCHANGE Panel -->
            <ScrollView x:Name="ExchangePanel" IsVisible="False">
                <StackLayout Padding="12" Spacing="12">
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#2D1B4E"
                            Stroke="#10B981" Padding="15">
                        <StackLayout Spacing="10">
                            <Label Text="Cambio $HPS" TextColor="#34D399" FontSize="18" FontAttributes="Bold" />
                            <Label Text="Troque HPS entre servidores ou usuarios."
                                   TextColor="#9CA3AF" FontSize="12" />
                            <Entry x:Name="ExchangeTargetEntry"
                                   Placeholder="Servidor de destino (host:porta)"
                                   PlaceholderColor="#6B7280" TextColor="White"
                                   BackgroundColor="#1A0A2E" />
                            <Entry x:Name="ExchangeAmountEntry"
                                   Placeholder="Valor ($HPS)"
                                   PlaceholderColor="#6B7280" TextColor="White"
                                   BackgroundColor="#1A0A2E" Keyboard="Numeric" />
                            <Button Text="Solicitar Cotacao" BackgroundColor="#10B981" TextColor="White"
                                    FontAttributes="Bold" HeightRequest="45" CornerRadius="10"
                                    Clicked="OnExchangeQuote" />
                            <Label x:Name="ExchangeStatusLabel" Text="" TextColor="#FBBF24" FontSize="12" />
                            <Border x:Name="ExchangeConfirmFrame" IsVisible="False"
                                    BackgroundColor="#064E3B" StrokeShape="RoundRectangle 8"
                                    Stroke="#10B981" Padding="10">
                                <VerticalStackLayout Spacing="8">
                                    <Label x:Name="ExchangeQuoteDetailLabel" Text=""
                                           TextColor="#E2E8F0" FontSize="12" />
                                    <Button Text="Executar Cambio" BackgroundColor="#10B981" TextColor="White"
                                            FontAttributes="Bold" HeightRequest="40" CornerRadius="8"
                                            Clicked="OnExecuteExchange" />
                                </VerticalStackLayout>
                            </Border>
                        </StackLayout>
                    </Border>
                </StackLayout>
            </ScrollView>

            <!-- HISTORY Panel -->
            <Grid x:Name="HistoryPanel" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="12">
                    <!-- Pending transfers section -->
                    <Border x:Name="PendingTransferFrame" Grid.Row="0" StrokeShape="RoundRectangle 15"
                            BackgroundColor="#2D1B4E" Stroke="#F59E0B" Padding="15" IsVisible="False">
                        <StackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Pendentes" TextColor="#FBBF24" FontSize="16" FontAttributes="Bold" />
                                <Button Grid.Column="1" Text="Atualizar" BackgroundColor="#3D1A6E"
                                        TextColor="#C084FC" FontSize="11" HeightRequest="32" CornerRadius="8"
                                        Clicked="OnRefreshPending" />
                            </Grid>
                            <ScrollView HeightRequest="200">
                                <VerticalStackLayout x:Name="PendingStack" Spacing="4" />
                            </ScrollView>
                        </StackLayout>
                    </Border>

                    <!-- History list -->
                    <Border Grid.Row="1" StrokeShape="RoundRectangle 15" BackgroundColor="#2D1B4E"
                            Stroke="#7C3AED" Padding="15">
                        <StackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Historico" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                <Button Grid.Column="1" Text="Atualizar" BackgroundColor="#3D1A6E"
                                        TextColor="#C084FC" FontSize="11" HeightRequest="32" CornerRadius="8"
                                        Clicked="OnRefreshHistory" />
                            </Grid>
                        </StackLayout>
                    </Border>

                    <!-- History items -->
                    <CollectionView Grid.Row="2" x:Name="HistoryCollection">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhuma transacao encontrada" TextColor="#6B7280"
                                   FontSize="13" HorizontalOptions="Center" Margin="0,20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#1A0A2E" Stroke="#3D1A6E"
                                        StrokeShape="RoundRectangle 8" Padding="10" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackLayout Grid.Column="0">
                                            <Label Text="{Binding Description}" TextColor="White" FontSize="13" />
                                            <Label Text="{Binding Date}" TextColor="#9CA3AF" FontSize="10" />
                                        </StackLayout>
                                        <Label Grid.Column="1" Text="{Binding Amount}" TextColor="{Binding AmountColor}"
                                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>

        </Grid>
    </Grid>

</ContentPage>
